# Hosted Stardeck settings. Copy to deploy/.env (git ignores it; never commit it) and fill in every value.

# --- Addresses (DNS: point both at this server) ---
APP_DOMAIN=app.stardeck.example
SHARE_DOMAIN=share.stardeck.example
ACME_EMAIL=you@stardeck.example                 # Let's Encrypt: certificate notices

# --- Backend ---
STARDECK_PUBLIC_URL=https://app.stardeck.example
STARDECK_SHARE_URL=https://share.stardeck.example
# Optional: a page about your service (e.g. the project's GitHub page). Shared dashboards and the
# demo link to it.
# STARDECK_SITE_URL=https://github.com/Artechie0806/Stardeck
# Optional: where "Upgrade" links in the app go (a pricing page or a mailto: link).
# STARDECK_UPGRADE_URL=mailto:you@stardeck.example?subject=Stardeck%20Enterprise
STARDECK_OPERATOR_EMAILS=you@stardeck.example   # these accounts see the AI server's details
# Encrypts stored database passwords. Make one and keep a copy in your password manager:
#   docker compose -f deploy/docker-compose.hosted.yml run --rm backend uv run --frozen python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STARDECK_SECRET_KEY=
STARDECK_SSRF_DENY=203.0.113.10                  # this server's public IP: data sources can't point back at it
STARDECK_MAX_UPLOAD_MB=100

# --- AI: your GPU over Tailscale (LM Studio) ---
STARDECK_LLM_BASE_URL=http://100.64.0.2:1234/v1
STARDECK_LLM_MODEL=qwen/qwen3.5-9b
STARDECK_LLM_PARALLEL=3                          # = LM Studio's "Max Concurrent Predictions"
