# Stardeck configuration. Every setting is documented in docs/configuration.md.

# --- Model: any OpenAI-compatible server. The id must match <base_url>/models. ---

# Option A: the Ollama container bundled in docker-compose (default)
STARDECK_LLM_MODEL=qwen3.5:9b
#   Bigger alternative: qwen3.6:35b-a3b (MoE, ~3B active params; ~24 GB VRAM at 4-bit)
#   Check exact tags with: docker compose exec ollama ollama list

# Option B: LM Studio on the host (Developer tab -> Start server, or `lms server start`)
# STARDECK_LLM_BASE_URL=http://host.docker.internal:1234/v1   # from Docker
# STARDECK_LLM_BASE_URL=http://localhost:1234/v1              # backend run outside Docker
# STARDECK_LLM_MODEL=qwen/qwen3.5-9b
# STARDECK_LLM_API_KEY=lm-studio

# Option C: vLLM, llama.cpp server, SGLang...
# STARDECK_LLM_BASE_URL=http://host.docker.internal:8000/v1

# Reasoning models "think" before answering; Stardeck turns that off by default because its calls
# are short and schema-constrained (thinking made them 10x+ slower with no accuracy gain).
# off (default) | on | server (send no switch, for strict OpenAI-compatible APIs)
# STARDECK_LLM_THINKING=off

# --- Access ---
# The app is published on all interfaces. If others on your network can reach it, set a password.
# STARDECK_PASSWORD=
STARDECK_PORT=3000

# --- Storage ---
# Encrypts saved database passwords. If unset, a key is generated into the data volume
# (data/secret.key). Back it up with the volume: losing it means re-entering passwords.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STARDECK_SECRET_KEY=

# Set to false to skip the built-in Retail demo source and dashboard.
# STARDECK_SEED_DEMO=true
